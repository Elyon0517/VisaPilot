<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.visa-auto</string>

    <key>ProgramArguments</key>
    <array>
      <string>/ABSOLUTE/PATH/TO/visa-auto/run-once.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/visa-auto</string>

    <!-- Example only: choose your own schedule in the machine's local timezone. -->
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    <key>EnvironmentVariables</key>
    <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>

    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/visa-auto/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/visa-auto/logs/launchd.err.log</string>

    <!-- 睡眠错过的时刻不补跑，避免醒来时连着起好几轮 -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
