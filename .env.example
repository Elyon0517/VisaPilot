# Copy to .env and fill locally. Never commit real credentials.
VISA_EMAIL=
VISA_PASSWORD=

# JSON mapping of your own security-answer input IDs to answers.
# Inspect your page locally; question IDs can differ between accounts.
VISA_SECURITY_ANSWERS={}

# Exact visible label of your desired consular post; required for login flow.
VISA_CONSULAR_POST=
HEADLESS=false
ALIGN=false
KEEP_OPEN=true
# Screenshots can contain personal data. Enable only for local debugging.
SAVE_SCREENSHOTS=false
